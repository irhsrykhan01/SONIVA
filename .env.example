# SONIVA owner number, international format without + or spaces.
# Example: 6281234567890
SONIVA_OWNER=

# Daily generation limits
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=50

# Media and processing limits
MAX_MEDIA_MB=64
MAX_STICKER_SECONDS=10
MAX_STICKER_BYTES=500000
AUDIO_BITRATE=32k
MAX_PENDING_MINUTES=8

# Paths (kept out of Git)
AUTH_DIR=auth_info
DATABASE_PATH=.data/soniva.sqlite
TIME_ZONE=Asia/Jakarta

# Optional: WhatsApp pairing code instead of QR. Use country code + number, digits only.
# PAIRING_NUMBER=
